{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.11.2",
  "schemes" : [
    {
      "buttons" : {
        "mappings" : [
          {
            "action" : "missionControl",
            "button" : 5,
            "command" : false,
            "control" : false,
            "option" : false,
            "shift" : false
          }
        ]
      },
      "if" : {
