set nu
set relativenumber
set ignorecase
set smartcase

inoremap jk <ESC>
nnoremap n nzz
nnoremap N Nzz
nnoremap <C-u> <C-u>zz
nnoremap <C-d> <C-d>zz
nnoremap <Tab> :tabnext<CR>
nnoremap <S-Tab> :tabprevious<CR>
nnoremap 'f :vsc ReSharper.ReSharper_GotoRecentFiles<CR>
nnoremap 'r :vsc ReSharper.ReSharper_GotoText<Cr>
